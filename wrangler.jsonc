{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coevo-caddie",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "observability": { "enabled": true },
  "dev": { "ip": "127.0.0.1", "port": 8788 },
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACE", "class_name": "Workspace" },
      { "name": "BUDGET", "class_name": "Budget" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Workspace", "Budget"] }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "coevo-caddie-media" }
  ],
  "vars": {
    "META_API_BASE_URL": "https://api.meta.ai/v1",
    "META_TEXT_MODEL": "muse-spark-1.3",
    "META_IMAGE_MODEL": "muse-image-1.0",
    "META_TRANSCRIBE_MODEL": "muse-voice-transcribe-1.0",
    "META_SEGMENT_MODEL": "sam-3.1",
    "COEVO_LIFETIME_CAP_USD": "100"
  }
}
